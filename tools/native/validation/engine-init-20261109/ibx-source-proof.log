   580	    // lavapipe advertises maxStorageBufferRange = 128 MiB, which refuses any
   581	    // frame above ~11 MP (a 3-channel float plane of 4284 x 2844 is 146 MB),
   582	    // and the CPU device is the fallback for a machine with no GPU at all.
   583	    // llvmpipe addresses an SSBO with 32-bit offsets, so on a CPU device only
   584	    // the range is *measured* rather than trusted: a dispatch over a buffer
   585	    // 16 MiB past the advertised limit must read and write distinct values on
   586	    // both sides of it. Only then is the limit raised to 4 GiB - 4, and the
   587	    // math_mode string says so. Any GPU keeps its advertised limit, and
   588	    // SPEKTRAFILM_VULKAN_STRICT_LIMITS=1 keeps it here too.
   589	    void probe_cpu_storage_range(std::string& detail) {
   590	        if (const char* strict = std::getenv("SPEKTRAFILM_VULKAN_STRICT_LIMITS"); strict && *strict == '1') return;
   591	        const VkDeviceSize advertised = properties_.limits.maxStorageBufferRange;
   592	        if (advertised >= 0xFFFFFFF0ull) return;
   593	        // spk_take_rgb over n RGBA pixels: it reads 16n bytes and writes 12n,
   594	        // both past the advertised range, with one thread per pixel (n stays
   595	        // under the 65535-workgroup dispatch limit).
   596	        const size_t n = size_t(advertised / 12) + (size_t(1) << 20);
   597	        if ((n + 255) / 256 > properties_.limits.maxComputeWorkGroupCount[0]) return;
   598	        std::vector<float> input(n * 4);
   599	        auto pattern = [](size_t i) { return float(uint32_t(i * 2654435761u) >> 8); };
   600	        for (size_t i = 0; i < input.size(); ++i) input[i] = pattern(i);
   601	        std::string error;
   602	        bool ok = false;
   603	        {
   604	            BufferRef in = upload(input.data(), input.size() * 4, error);
   605	            BufferRef out = alloc(n * 12, error);
   606	            const uint32_t meta[2] = {uint32_t(n), 4u};
   607	            if (in && out) {
   608	                storage_range_limit_ = VkDeviceSize(n) * 16;   // this one dispatch only
   609	                const bool ran = dispatch("spk_take_rgb", {Arg::buf(in), Arg::inline_bytes(meta, 2), Arg::buf(out)},
   610	                                          n, error);
   611	                storage_range_limit_ = advertised;
   612	                std::vector<float> got(n * 3);
   613	                if (ran && read(out.get(), 0, got.data(), n * 12, error)) {
   614	                    ok = true;
   615	                    for (size_t i = 0; ok && i < n; ++i)
   616	                        for (size_t c = 0; c < 3; ++c)
   617	                            if (got[3 * i + c] != pattern(4 * i + c)) { ok = false; break; }
   618	                }
   619	            }
   620	        }
   621	        // The probe's buffers would otherwise sit in the pool and be handed,
   622	        // at their full size, to the next small allocation.
   623	        trim_pool(0);
   624	        if (!ok) return;
   625	        storage_range_limit_ = 0xFFFFFFFCull;
   626	        detail += "; storage buffers past the advertised " + std::to_string(advertised >> 20) +
   627	                  " MiB maxStorageBufferRange verified by probe on this CPU device";
   628	    }
