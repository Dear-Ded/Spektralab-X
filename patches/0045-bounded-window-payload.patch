+// Payload admission, not an RSS limit: driver staging, thread stacks, tables,
+// allocator overhead and other live application buffers are outside this budget.
+inline ExternalBandPlan plan_external_bands(uint32_t w, uint32_t h, uint32_t rows,
+                                            uint32_t halo, unsigned workers, uint64_t budget) {
+    if (!w || !h || !rows) throw std::invalid_argument("empty external band geometry");
+    const uint64_t window = std::min<uint64_t>(h, uint64_t(rows) + 2ull * halo);
+    const uint64_t body = std::min(rows, h);
+    if (window * w > std::numeric_limits<uint32_t>::max() / 3)
+        throw std::invalid_argument("external window exceeds kernel pixel range");
+    ExternalBandPlan p;
+    const uint64_t count = (uint64_t(h) + rows - 1) / rows;
+    const uint64_t input = window * w * 3, output = body * w * 3;
+    const uint64_t fixed = count * sizeof(StripSpan) + 2ull * h;
+    const uint64_t per_worker = (input + output) * sizeof(float);
+    if (count > std::numeric_limits<size_t>::max() / sizeof(StripSpan) ||
+        input > std::numeric_limits<size_t>::max() / sizeof(float) ||
+        output > std::numeric_limits<size_t>::max() / sizeof(float) ||
+        fixed > budget || per_worker > budget - fixed)
+        throw std::invalid_argument("host payload budget cannot hold one external band worker");
+    p.bands = size_t(count); p.input_floats = size_t(input); p.output_floats = size_t(output);
+    p.workers = unsigned(std::min<uint64_t>({std::max(1u, workers), count, (budget - fixed) / per_worker}));
+    p.host_payload_bytes = fixed + uint64_t(p.workers) * per_worker;
+    return p;
+}
