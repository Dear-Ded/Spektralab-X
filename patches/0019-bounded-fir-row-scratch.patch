+++ b/engine/src/shaders/vulkan/spk_sep_fir_rows.comp
@@ -0,0 +1,63 @@
+#version 450
+// Co-created with GPT (OpenAI). The same two float32 FIR passes as
+// spk_sep_fir_acc, with only their address mapping changed for row scratch.
+layout(push_constant) uniform SpkDispatch { uint base; } spk_pc;
+layout(local_size_x = 256) in;
+layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } image_data;
+layout(set = 0, binding = 1, std430) readonly buffer Weights { float value[]; } weights;
+layout(set = 0, binding = 2, std430) readonly buffer Accumulator { float value[]; } accumulator;
+layout(set = 0, binding = 3, std430) readonly buffer MixWeights { float value[]; } mix_weights;
+layout(set = 0, binding = 4, std430) readonly buffer Meta { uint value[]; } meta;
+layout(set = 0, binding = 5, std430) writeonly buffer Output { float value[]; } output_data;
+
+uint spk_global_index() {
+    return (gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x + spk_pc.base);
+}
+
+int reflect_index(int index, int length) {
+    uint folded = index < 0 ? uint(-(index + 1)) : uint(index);
+    uint period = 2u * uint(length);
+    uint j = folded % period;
+    return int(j >= uint(length) ? period - 1u - j : j);
+}
+
+int mirror_index(int index, int length) {
+    if (length <= 1) return 0;
+    uint folded = index < 0 ? uint(-(index + 1)) + 1u : uint(index);
+    uint period = 2u * uint(length - 1);
+    uint j = folded % period;
+    return int(j >= uint(length) ? period - j : j);
+}
+
+void main() {
+    uint pixel = spk_global_index();
+    uint height = meta.value[0], width = meta.value[1];
+    if (pixel >= meta.value[7] * width) return;
+    int radius = int(meta.value[2]);
+    uint axis = meta.value[3], accumulate = meta.value[4], mirror = meta.value[5];
+    uint y = pixel / width, x = pixel % width;
+    int length = axis == 0u ? int(height) : int(width);
+    int base = axis == 0u ? int(y + meta.value[6]) : int(x);
+    uint taps = uint(2 * radius + 1);
+    vec3 sum = vec3(0.0);
+    for (int k = -radius; k <= radius; ++k) {
+        int j = mirror != 0u ? mirror_index(base + k, length)
+                             : reflect_index(base + k, length);
+        uint source = axis == 0u ? uint(j) * width + x : y * width + uint(j);
+        uint tap = uint(k + radius);
+        vec3 sample_value = vec3(image_data.value[3 * source],
+                                 image_data.value[3 * source + 1],
+                                 image_data.value[3 * source + 2]);
+        vec3 weight = vec3(weights.value[tap], weights.value[taps + tap],
+                           weights.value[2 * taps + tap]);
+        sum += sample_value * weight;
+    }
+    uint dest = axis == 0u ? pixel : pixel + meta.value[6] * width;
+    if (accumulate != 0u)
+        sum = vec3(accumulator.value[3 * dest], accumulator.value[3 * dest + 1],
+                   accumulator.value[3 * dest + 2])
+              + sum * vec3(mix_weights.value[0], mix_weights.value[1], mix_weights.value[2]);
+    output_data.value[3 * dest] = sum.x;
+    output_data.value[3 * dest + 1] = sum.y;
+    output_data.value[3 * dest + 2] = sum.z;
+}
