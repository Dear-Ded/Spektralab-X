+        if (unlinked < 0) {
+            close(fd_); fd_ = -1;
+            throw std::runtime_error("cannot unlink external plane");
+        }
+        int reserved;
+        do { reserved = posix_fallocate(fd_, 0, off_t(bytes())); } while (reserved == EINTR);
+        if (reserved != 0) {
+            close(fd_); fd_ = -1;
+            throw std::runtime_error("cannot reserve external plane space");
+        }
+    }
+    ~ExternalPlane() { if (fd_ >= 0) close(fd_); }
+    ExternalPlane(const ExternalPlane&) = delete;
+    ExternalPlane& operator=(const ExternalPlane&) = delete;
+
+    uint32_t width() const { return w_; }
+    uint32_t height() const { return h_; }
+    uint32_t channels() const { return c_; }
+    uint64_t row_bytes() const { return uint64_t(w_) * c_ * sizeof(float); }
+    uint64_t bytes() const { return row_bytes() * h_; }
+    uint64_t coverage_bytes() const { return h_; }
+
+    bool ready() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return state_ == State::Sealed;
+    }
+    Producer producer() {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (state_ != State::Filling || written_ || pending_)
+            throw std::logic_error("external plane output must be empty");
+        state_ = State::Producing;
+        return Producer(this);
+    }
+    void seal() { seal_from(State::Filling); }
+
+    void write_rows(uint32_t y, uint32_t rows, const float* data, const BoundedCancel& cancel = {}) {
+        write(y, rows, data, State::Filling, cancel);
+    }
+    void read_rows(uint32_t y, uint32_t rows, float* out, const BoundedCancel& cancel = {}) const {
+        validate(y, rows, out);
+        if (!ready()) throw std::logic_error("external plane is not sealed");
+        io(false, y, rows, out, cancel);
+    }
+
+private:
+    void invalidate() noexcept {
+        std::lock_guard<std::mutex> lock(mutex_);
+        state_ = State::Failed;
+    }
+    void seal_from(State required) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (state_ == State::Sealed && required == State::Filling) return;
+        if (state_ != required) throw std::logic_error("external plane cannot be sealed in this state");
+        if (pending_ || written_ != h_) throw std::logic_error("incomplete external plane");
+        state_ = State::Sealed;
+    }
+    void validate(uint32_t y, uint32_t rows, const float* data) const {
+        if (y > h_ || rows > h_ - y) throw std::out_of_range("external plane rows");
+        if (rows && (!data || row_bytes() > std::numeric_limits<size_t>::max() / rows))
+            throw std::invalid_argument("invalid external plane row storage");
+    }
+    void write(uint32_t y, uint32_t rows, const float* data, State required, const BoundedCancel& cancel) {
+        validate(y, rows, data);
+        bounded_cancel_checkpoint(cancel);
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (state_ != required) throw std::logic_error("external plane is not writable");
+            for (uint32_t i = 0; i < rows; ++i)
+                if (rows_[y + i]) throw std::logic_error("external plane rows overlap");
+            if (!rows) return;
+            std::fill_n(rows_.get() + y, rows, uint8_t(1));
+            ++pending_;
+        }
+        try {
+            io(true, y, rows, const_cast<float*>(data), cancel);
+        } catch (...) {
+            std::lock_guard<std::mutex> lock(mutex_);
+            --pending_;
+            state_ = State::Failed;
+            throw;
+        }
+        std::lock_guard<std::mutex> lock(mutex_);
+        --pending_;
+        if (state_ != required) throw std::logic_error("external plane output was aborted");
+        std::fill_n(rows_.get() + y, rows, uint8_t(2));
+        written_ += rows;
+    }
+    void io(bool write, uint32_t y, uint32_t rows, float* data, const BoundedCancel& cancel) const {
+        char* p = reinterpret_cast<char*>(data);
+        size_t left = size_t(rows * row_bytes());
+        off_t off = off_t(y * row_bytes());
+        while (left) {
+            bounded_cancel_checkpoint(cancel);
+            const size_t chunk = std::min<size_t>(left, 1u << 20);
+            const ssize_t n = write ? pwrite(fd_, p, chunk, off) : pread(fd_, p, chunk, off);
+            if (n < 0 && errno == EINTR) continue;
+            if (n <= 0 || size_t(n) > chunk) throw std::runtime_error("external plane io failed");
+            p += n; off += n; left -= size_t(n);
+        }
+        bounded_cancel_checkpoint(cancel);
+    }
+    int fd_ = -1;
+    uint32_t w_, h_, c_, written_ = 0, pending_ = 0;
+    std::unique_ptr<uint8_t[]> rows_;
+    mutable std::mutex mutex_;
+    State state_ = State::Filling;
+};
+
+} // namespace spk
