diff --git a/engine/src/io/raw_cancellation.hpp b/engine/src/io/raw_cancellation.hpp
new file mode 100644
index 0000000..738c2c1
--- /dev/null
+++ b/engine/src/io/raw_cancellation.hpp
@@ -0,0 +1,50 @@
+#pragma once
+
+// Co-created with GPT (OpenAI). Cancellation is observed without throwing out
+// of a LibRaw/OpenMP worker. The caller discards a partially processed decoder.
+#include <atomic>
+#include <functional>
+#include <mutex>
+#include <stdexcept>
+
+namespace spk::io {
+
+using RawDecodeCancel = std::function<bool()>;
+
+class RawDecodeCancelled final : public std::runtime_error {
+public:
+    RawDecodeCancelled() : std::runtime_error("RAW decode cancelled") {}
+};
+
+namespace detail {
+class RawDecodeProgress {
+public:
+    explicit RawDecodeProgress(const RawDecodeCancel& callback) : callback_(callback) {}
+    RawDecodeProgress(const RawDecodeProgress&) = delete;
+    RawDecodeProgress& operator=(const RawDecodeProgress&) = delete;
+
+    // LibRaw may call from decoder workers. Serialise external callbacks so a
+    // caller's state needs no separate decoder-worker synchronisation.
+    bool poll() noexcept {
+        if (stopped_.load(std::memory_order_relaxed)) return true;
+        if (!callback_) return false;
+        try {
+            std::lock_guard<std::mutex> guard(mutex_);
+            if (stopped_.load(std::memory_order_relaxed)) return true;
+            if (callback_()) stopped_.store(true, std::memory_order_relaxed);
+        } catch (...) {
+            stopped_.store(true, std::memory_order_relaxed);
+        }
+        return stopped_.load(std::memory_order_relaxed);
+    }
+
+    // Only the initiating thread throws, after decoder or adapter workers join.
+    void check() { if (poll()) throw RawDecodeCancelled(); }
+
+private:
+    const RawDecodeCancel& callback_;
+    std::atomic<bool> stopped_{false};
+    std::mutex mutex_;
+};
+} // namespace detail
+} // namespace spk::io
