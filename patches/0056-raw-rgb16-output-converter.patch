+// Co-created with GPT (OpenAI). A borrowed, oriented native-endian RGB16
+// bitmap. Valid only during the converter call, after LibRaw is released.
+struct RawRgb16View {
+    const std::uint8_t* data = nullptr;
+    std::size_t bytes = 0;
+    std::uint32_t width = 0, height = 0;
+};
+
+struct RawFloatImage {
+    std::uint32_t width = 0, height = 0;
+    std::vector<float> rgb;
+};
+
+// Return false to retain the normal full-size conversion. A true result must
+// contain packed float RGB, with nonzero dimensions no larger than the source.
+// The supplied cancellation poll is serialised, sticky and safe on workers;
+// workers must join before returning. Cancellation takes precedence over errors.
+using RawRgb16Converter = std::function<bool(const RawRgb16View&, RawFloatImage&,
+                                            const RawDecodeCancel&)>;
