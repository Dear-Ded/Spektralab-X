--- /dev/null
+++ b/engine/src/pipeline/finite_output.hpp
@@ -0,0 +1,43 @@
+#pragma once
+// Co-created with GPT (OpenAI), 2026-11-12. See NOTICE.
+#include "image.hpp"
+#include <limits>
+#include <string>
+
+namespace spk {
+inline bool finite_output(gpu::Gpu* gpu, const Image& image, std::string& error) {
+#if defined(SPK_VULKAN_BACKEND)
+    if (!image.valid() || image.c != 3 ||
+        image.pixels() > std::numeric_limits<uint32_t>::max() / 3) {
+        error = "render integrity: invalid RGB layout";
+        return false;
+    }
+    const uint32_t count = uint32_t(image.pixels());
+    const uint32_t initial[2] = {UINT32_MAX, 0};
+    auto summary = gpu->upload_u32(initial, 2, error);
+    if (!summary || !gpu->dispatch("spk_validate_finite",
+            {gpu::Arg::buf(image.buf), gpu::Arg::inline_bytes(&count, 1),
+             gpu::Arg::buf(summary)}, count, error) || !gpu->flush(error)) return false;
+    uint32_t got[2]{};
+    if (!gpu->read(summary.get(), 0, got, sizeof got, error)) return false;
+    const uint32_t groups = count / 256 + (count % 256 != 0);
+    if (got[1] != groups) {
+        error = "render integrity: incomplete GPU validation (" +
+            std::to_string(got[1]) + "/" + std::to_string(groups) + " groups)";
+        return false;
+    }
+    if (got[0] != UINT32_MAX) {
+        const uint32_t pixel = got[0] / 3;
+        error = "render integrity: non-finite RGB at (" +
+            std::to_string(pixel % image.w) + ", " + std::to_string(pixel / image.w) +
+            "), channel " + std::to_string(got[0] % 3);
+        return false;
+    }
+#else
+    (void)gpu;
+    (void)image;
+    (void)error;
+#endif
+    return true;
+}
+} // namespace spk
