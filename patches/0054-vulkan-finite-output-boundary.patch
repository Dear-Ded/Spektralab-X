@@ -0,0 +1,23 @@
+#version 450
+// Co-created with GPT (OpenAI), 2026-11-12. See NOTICE.
+layout(push_constant) uniform SpkDispatch { uint base; } spk_pc;
+layout(local_size_x = 256) in;
+layout(binding = 0, std430) readonly buffer Input { float v[]; } src;
+layout(binding = 1, std430) readonly buffer Meta { uint v[]; } meta;
+layout(binding = 2, std430) buffer Summary { uint v[]; } summary;
+void main() {
+    // One atomic per workgroup on healthy frames, rather than per pixel.
+    if (gl_LocalInvocationID.x == 0u) atomicAdd(summary.v[1], 1u);
+    uint i = spk_pc.base + gl_GlobalInvocationID.x;
+    if (i >= meta.v[0]) return;
+    for (uint c = 0u; c < 3u; ++c) {
+        // Test IEEE exponent bits so signed finite HDR values stay valid.
+        uint bits = floatBitsToUint(src.v[3u * i + c]);
+        if ((bits & 0x7f800000u) == 0x7f800000u) {
+            atomicMin(summary.v[0], 3u * i + c);
+            break;
+        }
+    }
+}
