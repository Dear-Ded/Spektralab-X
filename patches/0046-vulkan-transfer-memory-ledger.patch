+        std::lock_guard<std::mutex> dispatch_lock(dispatch_mutex_);
+        std::lock_guard<std::mutex> lock(buffers_mutex_);
+        BackendMemoryStats out;
+        out.available = true;
+        for (const Buffer* b : buffers_) out.buffer_allocation_bytes += b->allocation_bytes;
+        out.upload_staging_allocation_bytes = upload_staging_.allocation_bytes;
+        out.read_staging_allocation_bytes = read_staging_.allocation_bytes;
+        out.inline_ring_allocation_bytes = inline_ring_.allocation_bytes;
+        return out;
+    }
+    uint64_t trim_transfer_staging() override {
+        // All submissions finish under this mutex, so no command can still
+        // name these buffers. Image buffers and the argument ring stay intact.
+        std::lock_guard<std::mutex> lock(dispatch_mutex_);
+        const uint64_t freed = upload_staging_.allocation_bytes + read_staging_.allocation_bytes;
+        destroy_buffer(&upload_staging_);
+        destroy_buffer(&read_staging_);
+        return freed;
+    }
