+// Backend-owned allocation capacities, separate from logical pool sizes.
+// Vulkan reports vkAllocateMemory sizes including its transfer staging/ring;
+// driver-private memory and process RSS are not measured by this ledger.
+struct BackendMemoryStats {
+    bool available = false;
+    uint64_t buffer_allocation_bytes = 0;
+    uint64_t upload_staging_allocation_bytes = 0;
+    uint64_t read_staging_allocation_bytes = 0;
+    uint64_t inline_ring_allocation_bytes = 0;
+    uint64_t total_bytes() const {
+        return buffer_allocation_bytes + upload_staging_allocation_bytes +
+            read_staging_allocation_bytes + inline_ring_allocation_bytes;
+    }
+};
+
