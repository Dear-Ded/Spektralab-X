+// Experimental production entry: no wire/default changes. This bounds only one
+// tail's window/host payload, not full images, idle pools or concurrent sessions.
+bool bounded_tail_enabled(bool& enabled, std::string& error) {
+    const char* value = std::getenv("SPK_BOUNDED_PRINT_TAIL");
+    enabled = value && std::strcmp(value, "1") == 0;
+    if (!value || enabled || std::strcmp(value, "0") == 0) return true;
+    error = "SPK_BOUNDED_PRINT_TAIL must be 0 or 1";
+    return false;
+}
+
+#if defined(__linux__)
+bool bounded_tail_number(const char* name, uint64_t fallback, uint64_t limit,
+                         uint64_t& out, std::string& error) {
+    const char* value = std::getenv(name);
+    out = fallback;
+    if (!value) return true;
+    const size_t length = std::strlen(value);
+    if (length && length <= 20) {
+        const auto parsed = std::from_chars(value, value + length, out);
+        if (parsed.ec == std::errc{} && parsed.ptr == value + length && out && out <= limit) return true;
+    }
+    error = std::string(name) + " must be a positive decimal within its limit";
+    return false;
+}
+#endif
