+#pragma once
+// Co-created with GPT (OpenAI). DNG SDK SetWhiteXY for the explicit-xy path.
+#include "dng_forward_matrix.hpp"
+
+namespace spk::io::detail::dng_white_xy {
+using namespace dng_forward;
+
+inline bool valid(double x, double y) {
+    return std::isfinite(x) && std::isfinite(y) && x > 0 && y > 0 && x + y < 1;
+}
+
+// Robertson isotemperature lines, shared numerically with host/white_balance.cpp.
+// Keep this path independent of host linkage and of the legacy neutral solver.
+inline double temperature(double x, double y) {
+    struct Line { double r, u, v, t; };
+    constexpr Line table[] = {
+        {0,.18006,.26352,-.24341},{10,.18066,.26589,-.25479},
+        {20,.18133,.26846,-.26876},{30,.18208,.27119,-.28539},
+        {40,.18293,.27407,-.30470},{50,.18388,.27709,-.32675},
+        {60,.18494,.28021,-.35156},{70,.18611,.28342,-.37915},
+        {80,.18740,.28668,-.40955},{90,.18880,.28997,-.44278},
+        {100,.19032,.29326,-.47888},{125,.19462,.30141,-.58204},
+        {150,.19962,.30921,-.70471},{175,.20525,.31647,-.84901},
+        {200,.21142,.32312,-1.0182},{225,.21807,.32909,-1.2168},
+        {250,.22511,.33439,-1.4512},{275,.23247,.33904,-1.7298},
+        {300,.24010,.34308,-2.0637},{325,.24792,.34655,-2.4681},
+        {350,.25591,.34951,-2.9641},{375,.26400,.35200,-3.5814},
+        {400,.27218,.35407,-4.3633},{425,.28039,.35577,-5.3762},
+        {450,.28863,.35714,-6.7262},{475,.29685,.35823,-8.5955},
+        {500,.30505,.35907,-11.324},{525,.31320,.35968,-15.628},
+        {550,.32129,.36011,-23.325},{575,.32931,.36038,-40.770},
+        {600,.33724,.36051,-116.45}
+    };
+    const double u = 2*x/(1.5-x+6*y), v = 3*y/(1.5-x+6*y);
+    double previous = 0;
+    for (int i=1;i<=30;++i) {
+        double distance = (v-table[i].v-(u-table[i].u)*table[i].t) /
+                          std::sqrt(1+table[i].t*table[i].t);
+        if (distance<=0 || i==30) {
+            distance = std::max(0.,-distance);
+            const double weight=i==1 ? 0. : distance/(previous+distance);
+            return 1e6/(table[i-1].r*weight+table[i].r*(1-weight));
+        }
+        previous=distance;
+    }
+    return 0;
+}
+
+inline bool prepare(const Profile& profile, double x, double y, Prepared& result) {
+    if (!valid(x,y)) return false;
+    const double kelvin=temperature(x,y);
+    if (!(kelvin>0) || !std::isfinite(kelvin)) return false;
+    Prepared calibration;
+    if (!dng_forward::prepare(profile,Vector{1,1,1},calibration,kelvin)) return false;
+    Vector neutral=multiply(calibration.camera_from_xyz,Vector{x/y,1,(1-x-y)/y});
+    const double maximum=*std::max_element(neutral.begin(),neutral.end());
+    if (!(maximum>0) || !std::isfinite(maximum)) return false;
+    for (double& value:neutral) {
+        if (!std::isfinite(value)) return false;
+        value=std::clamp(value/maximum,.001,1.);
+    }
+    return dng_forward::prepare(profile,neutral,result,kelvin);
+}
+
+// Without ForwardMatrix the SDK adapts XYZ using linear Bradford, and scales
+// so the selected camera white reaches PCS white at first-channel saturation.
+inline bool complete_without_forward(Prepared& prepared, double x, double y) {
+    if (prepared.has_forward) return true;
+    if (!valid(x,y)) return false;
+    constexpr Matrix bradford{.8951,.2664,-.1614,-.7502,1.7135,.0367,.0389,-.0685,1.0296};
+    Matrix inverse_bradford{}, inverse_camera{};
+    if (!inverse(bradford,inverse_bradford) || !inverse(prepared.camera_from_xyz,inverse_camera)) return false;
+    const Vector xyz{x/y,1,(1-x-y)/y};
+    Matrix ratio{};
+    // Compute the SDK's forward D50-to-source adaptation and invert the
+    // complete PCS-to-camera transform, including its saturation scale.
+    const Vector pcs_lms=multiply(bradford,white);
+    const Vector shot_lms=multiply(bradford,xyz);
+    for(int i=0;i<3;++i) {
+        const double a=std::max(0.,pcs_lms[i]),b=std::max(0.,shot_lms[i]);
+        ratio[i*3+i]=std::clamp(a>0 ? b/a : 10.,.1,10.);
+    }
+    const Matrix pcs_to_camera=multiply(prepared.camera_from_xyz,
+        multiply(multiply(inverse_bradford,ratio),bradford));
+    const Vector response=multiply(pcs_to_camera,white);
+    const double scale=*std::max_element(response.begin(),response.end());
+    Matrix adaptation{};
+    if (!(scale>0) || !std::isfinite(scale) || !inverse(pcs_to_camera,adaptation)) return false;
+    for(double& value:adaptation)value*=scale;
+    if(!finite(adaptation))return false;
+    prepared.camera_to_pcs=adaptation;
+    prepared.has_forward=true;
+    return true;
+}
+} // namespace spk::io::detail::dng_white_xy
