+    bool interpolate_dng_white_xy(const std::array<float, 4>* user_mul, double selected_kelvin) {
+        auto& col=imgdata.color;
+        const auto& levels=col.dng_levels;
+        dng_white_xy_error="RAW metadata: unsupported or invalid DNG AsShotWhiteXY calibration";
+        if (levels.calibration_signature_invalid) return false;
+        dng_forward::Profile profile;
+        const bool calibrated=std::strcmp(levels.camera_calibration_signature,
+                                          levels.profile_calibration_signature)==0;
+        for(int s=0;s<2;++s) {
+            auto& slot=profile.slots[s];
+            slot.kelvin=illuminant_k(col.dng_color[s].illuminant);
+            bool missing=true;
+            for(int r=0;r<3;++r)for(int c=0;c<3;++c) {
+                slot.color[r*3+c]=col.dng_color[s].colormatrix[r][c];
+                slot.forward[r*3+c]=col.dng_color[s].forwardmatrix[r][c];
+                missing &= col.dng_color[s].calibration[r][c]==0;
+            }
+            for(int r=0;r<3;++r)for(int c=0;c<3;++c)
+                slot.calibration[r*3+c]=calibrated&&!missing ?
+                    col.dng_color[s].calibration[r][c] : double(r==c);
+        }
+        for(int c=0;c<3;++c) {
+            const double a=levels.analogbalance[c];
+            profile.analog[c]=a==0 ? 1. : a;
+        }
+        dng_forward::Prepared source;
+        if(!dng_white_xy::prepare(profile,levels.asshotwhitexy[0],levels.asshotwhitexy[1],source)) return false;
+        for(int c=0;c<3;++c)col.cam_mul[c]=float(1/source.neutral[c]);
+        col.cam_mul[3]=col.cam_mul[1];
+        dng_white_xy_derived=true;
+        dng_forward::Prepared selected=source;
+        double x=levels.asshotwhitexy[0],y=levels.asshotwhitexy[1];
+        if(user_mul || selected_kelvin>0) {
+            dng_forward::Vector neutral=source.neutral;
+            if(user_mul)for(int c=0;c<3;++c) {
+                const double wb=(*user_mul)[c];
+                if(!(wb>0)||!std::isfinite(wb))return false;
+                neutral[c]=1/wb;
+            }
+            if(!dng_forward::prepare(profile,neutral,selected,selected_kelvin))return false;
+            dng_forward::Matrix inv{};
+            if(!dng_forward::inverse(selected.camera_from_xyz,inv))return false;
+            const auto xyz=dng_forward::multiply(inv,selected.neutral);
+            const double sum=xyz[0]+xyz[1]+xyz[2];
+            if(!(sum>0)||!std::isfinite(sum))return false;
+            x=xyz[0]/sum;y=xyz[1]/sum;
+        }
+        if(!dng_white_xy::complete_without_forward(selected,x,y))return false;
+        double camera[4][3]={};
+        for(int r=0;r<3;++r)for(int c=0;c<3;++c)
+            camera[r][c]=selected.camera_from_xyz[r*3+c];
+        float pre[4],rgb[3][4]={};
+        std::memcpy(pre,col.pre_mul,sizeof pre);
+        cam_xyz_coeff(rgb,camera);
+        std::memcpy(col.pre_mul,pre,sizeof pre);
+        std::memcpy(col.rgb_cam,rgb,sizeof rgb);
+        for(int r=0;r<3;++r)for(int c=0;c<3;++c)
+            col.cam_xyz[r][c]=float(camera[r][c]);
+        forward_=selected;
+        dng_matrix_k=selected.kelvin;
+        dng_white_xy_error.clear();
+        return true;
+    }
