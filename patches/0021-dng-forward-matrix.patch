+#pragma once
+// DNG camera-to-PCS construction (DNG SDK dng_color_spec::SetWhiteXY).
+// ForwardMatrix operates on reference-camera RGB, after white balancing.
+// No profile tone curve, look table, or exposure adjustment belongs here.
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace spk::io::detail::dng_forward {
+using Matrix = std::array<double, 9>;
+using Vector = std::array<double, 3>;
+constexpr Matrix identity{1,0,0,0,1,0,0,0,1};
+// The engine's linear ProPhoto D50 colorants (host/image_io.cpp).
+constexpr Matrix prophoto_to_xyz{.7976749,.1351917,.0313534,.2880402,.7118741,.0000857,0,0,.8252100};
+constexpr Vector white{.9642200,1.0,.8252100};
+
+struct Calibration {
+    double kelvin = 0;
+    Matrix color{}, calibration = identity, forward{};
+};
+struct Profile {
+    Calibration slots[2];
+    Vector analog{1,1,1};
+};
+struct Prepared {
+    Matrix camera_from_xyz{}, camera_to_pcs{};
+    Vector neutral{};
+    double kelvin = 0;
+    bool has_forward = false;
+};
+
+inline bool finite(const Matrix& m) {
+    for (double v : m) if (!std::isfinite(v)) return false;
+    return true;
+}
+inline bool zero(const Matrix& m) {
+    for (double v : m) if (v != 0) return false;
+    return true;
+}
+inline Matrix multiply(const Matrix& a, const Matrix& b) {
+    Matrix out{};
+    for (int r=0;r<3;++r) for (int c=0;c<3;++c)
+        for (int k=0;k<3;++k) out[r*3+c]+=a[r*3+k]*b[k*3+c];
+    return out;
+}
+inline Vector multiply(const Matrix& a, const Vector& b) {
+    Vector out{};
+    for (int r=0;r<3;++r) for(int c=0;c<3;++c) out[r]+=a[r*3+c]*b[c];
+    return out;
+}
+inline bool inverse(const Matrix& m, Matrix& result) {
+    if (!finite(m)) return false;
+    const auto [a,b,c,d,e,f,g,h,i]=m;
+    const double det=a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g);
+    double scale=0;for(double v:m)scale=std::max(scale,std::fabs(v));
+    if (!(scale>0) || !std::isfinite(det) || std::fabs(det)<=1e-12*scale*scale*scale) return false;
+    Matrix out{e*i-f*h,c*h-b*i,b*f-c*e,f*g-d*i,a*i-c*g,c*d-a*f,d*h-e*g,b*g-a*h,a*e-b*d};
+    for(double& v:out)v/=det;
+    if(!finite(out))return false;
+    result=out;return true;
+}
+inline Matrix blend(const Matrix& a,const Matrix& b,double weight) {
+    Matrix out{};for(int i=0;i<9;++i)out[i]=weight*a[i]+(1-weight)*b[i];return out;
+}
+inline double first_weight(double k,double t1,double t2) {
+    if (!(t1>0 && t2>0) || std::fabs(t1-t2)<1) return 1;
+    return std::clamp((1/k-1/t2)/(1/t1-1/t2),0.,1.);
+}
+inline double cct(double x,double y) {
+    const double d=.1858-y;
+    if(std::fabs(d)<1e-9)return 6500;
+    const double n=(x-.3320)/d;
+    const double k=((449*n+3525)*n+6823.3)*n+5520.33;
+    return std::isfinite(k)?std::clamp(k,1500.,50000.):6500.;
+}
+
+inline bool normalize_forward(Matrix& m) {
+    Matrix unused{};
+    if(!inverse(m,unused))return false;
+    for(int r=0;r<3;++r) {
+        const double sum=m[r*3]+m[r*3+1]+m[r*3+2];
+        if(!(sum>1e-12) || !std::isfinite(sum))return false;
+        for(int c=0;c<3;++c)m[r*3+c]*=white[r]/sum;
+    }
+    return finite(m);
+}
+
+// A missing/invalid forward matrix leaves has_forward false, so callers keep
+// the established ColorMatrix conversion. Metadata still gets a valid CM.
+// Every failure leaves the caller's Prepared untouched.
+// An explicit custom WB already identifies the illuminant. NeutralToXY can
+// have multiple roots away from the locus, so do not infer it a second time.
+inline bool prepare(const Profile& p,Vector neutral,Prepared& result,double selected_kelvin=0) {
+    if(selected_kelvin!=0 && (!(selected_kelvin>0)||!std::isfinite(selected_kelvin)))return false;
+    const double max_neutral=*std::max_element(neutral.begin(),neutral.end());
+    for(double& v:neutral) {
+        if(!(v>0) || !std::isfinite(v))return false;
+        v/=max_neutral;
+    }
+    for(double a:p.analog)if(!(a>0)||!std::isfinite(a))return false;
+    Matrix test{};
+    const bool valid[2]={inverse(p.slots[0].color,test),inverse(p.slots[1].color,test)};
+    if(!valid[0]&&!valid[1])return false;
+    const int a=valid[0]?0:1,b=valid[1]?1:a;
+    const bool dual=a!=b && p.slots[a].kelvin>0 && p.slots[b].kelvin>0 &&
+        std::fabs(p.slots[a].kelvin-p.slots[b].kelvin)>=1;
+    Matrix analog{p.analog[0],0,0,0,p.analog[1],0,0,0,p.analog[2]};
+    auto calibration=[&](double k) {
+        const double w=dual?first_weight(k,p.slots[a].kelvin,p.slots[b].kelvin):1.;
+        return multiply(analog,blend(p.slots[a].calibration,p.slots[b].calibration,w));
+    };
+    // The DNG SDK composes each calibration endpoint before interpolating it.
+    const Matrix camera_a=multiply(multiply(analog,p.slots[a].calibration),p.slots[a].color);
+    const Matrix camera_b=multiply(multiply(analog,p.slots[b].calibration),p.slots[b].color);
+    auto camera=[&](double k) {
+        const double w=dual?first_weight(k,p.slots[a].kelvin,p.slots[b].kelvin):1.;
+        return blend(camera_a,camera_b,w);
+    };
+    double kelvin=selected_kelvin;
+    if(kelvin==0) {
+        double x=.3457,y=.3585;
+        for(int pass=0;pass<30;++pass) {
+            Matrix inv{};if(!inverse(camera(cct(x,y)),inv))return false;
+            const Vector xyz=multiply(inv,neutral);
+            const double sum=xyz[0]+xyz[1]+xyz[2];
+            if(!(sum>0)||!(xyz[1]>0)||!std::isfinite(sum))return false;
+            double nx=xyz[0]/sum,ny=xyz[1]/sum;
+            if(std::fabs(nx-x)+std::fabs(ny-y)<1e-7){x=nx;y=ny;break;}
+            if(pass==29){nx=(nx+x)*.5;ny=(ny+y)*.5;}
+            x=nx;y=ny;
+        }
+        kelvin=cct(x,y);
+    }
+    Prepared out;
+    out.kelvin=kelvin;out.neutral=neutral;out.camera_from_xyz=camera(out.kelvin);
+    if(!inverse(out.camera_from_xyz,test))return false;
+    Matrix f1=p.slots[a].forward,f2=p.slots[b].forward;
+    const bool has1=!zero(f1),has2=!zero(f2);
+    bool valid_forward=has1||has2;
+    if(has1)valid_forward&=normalize_forward(f1);
+    if(has2)valid_forward&=normalize_forward(f2);
+    if(valid_forward) {
+        if(!has1)f1=f2;
+        if(!has2)f2=f1;
+        const double w=dual?first_weight(out.kelvin,p.slots[a].kelvin,p.slots[b].kelvin):1.;
+        Matrix inv_cal{};
+        if(inverse(calibration(out.kelvin),inv_cal)) {
+            const Vector ref=multiply(inv_cal,neutral);
+            if(ref[0]>1e-12&&ref[1]>1e-12&&ref[2]>1e-12) {
+                const Matrix inv_white{1/ref[0],0,0,0,1/ref[1],0,0,0,1/ref[2]};
+                out.camera_to_pcs=multiply(multiply(blend(f1,f2,w),inv_white),inv_cal);
+                out.has_forward=finite(out.camera_to_pcs);
+            }
+        }
+    }
+    result=out;return true;
+}
+
+// LibRaw has already applied WB to image[]. Remove only those relative
+// multipliers before the DNG matrix; keep the existing exposure normalization
+// (including headroom mode) and let LibRaw keep its normal output quantization.
+inline bool post_wb_to_prophoto(const Prepared& p,const float wb[4],Matrix& result) {
+    if(!p.has_forward)return false;
+    Vector neutral{};double maximum=0;
+    for(int i=0;i<3;++i) {
+        if(!(wb[i]>0)||!std::isfinite(wb[i]))return false;
+        neutral[i]=1./wb[i];maximum=std::max(maximum,neutral[i]);
+    }
+    for(int i=0;i<3;++i) {
+        neutral[i]/=maximum;
+        // Some linear DNGs arrive with WB already applied. Do not apply a
+        // transform built for different camera-white ratios to their pixels.
+        if(std::fabs(neutral[i]-p.neutral[i])>1e-4)return false;
+    }
+    Matrix inv{};if(!inverse(prophoto_to_xyz,inv))return false;
+    Matrix out=multiply(inv,p.camera_to_pcs);
+    for(int r=0;r<3;++r)for(int c=0;c<3;++c)out[r*3+c]*=neutral[c];
+    if(!finite(out))return false;
+    result=out;return true;
+}
+} // namespace spk::io::detail::dng_forward
