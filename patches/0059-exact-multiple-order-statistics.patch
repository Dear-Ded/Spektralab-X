+// Co-created with GPT (OpenAI). Exact ranks without sorting every sample.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+namespace spk::detail {
+
+inline bool rank_has_ambiguous_values(const std::vector<double>& values) {
+    bool positive_zero = false, negative_zero = false;
+    for (double value : values) {
+        if (std::isnan(value)) return true;
+        if (value == 0.0) {
+            if (std::signbit(value)) negative_zero = true;
+            else positive_zero = true;
+        }
+    }
+    return positive_zero && negative_zero;
+}
+
+// Preconditions: nonempty values; nondecreasing, valid zero-based ranks.
+// A selected pivot bounds both recursive searches; equal ranks share its value.
+// Keep the historical whole-range selection order for unordered values and
+// signed-zero ties, whose exact bits are not determined by numeric rank alone.
+template<size_t N>
+std::array<double, N> select_ranks(std::vector<double>& values,
+                                 const std::array<size_t, N>& ranks) {
+    static_assert(N > 0);
+    std::array<double, N> result{};
+    if (rank_has_ambiguous_values(values)) {
+        for (size_t i = 0; i < N; ++i) {
+            std::nth_element(values.begin(), values.begin() + ranks[i], values.end());
+            result[i] = values[ranks[i]];
+        }
+        return result;
+    }
+    const auto choose = [&](auto&& self, size_t first, size_t last,
+                            size_t lo, size_t hi) -> void {
+        if (first == last) return;
+        const size_t middle = first + (last - first - 1) / 2;
+        const size_t k = ranks[middle];
+        std::nth_element(values.begin() + lo, values.begin() + k, values.begin() + hi);
+        size_t a = middle, b = middle + 1;
+        while (a > first && ranks[a - 1] == k) --a;
+        while (b < last && ranks[b] == k) ++b;
+        for (size_t i = a; i < b; ++i) result[i] = values[k];
+        self(self, first, a, lo, k);
+        self(self, b, last, k + 1, hi);
+    };
+    choose(choose, 0, N, 0, values.size());
+    return result;
+}
+
+inline double median_in_place(std::vector<double>& values) {
+    const size_t n = values.size(), middle = n / 2;
+    if (rank_has_ambiguous_values(values)) {
+        std::sort(values.begin(), values.end());
+        return n % 2 ? values[middle] : 0.5 * (values[middle - 1] + values[middle]);
+    }
+    std::nth_element(values.begin(), values.begin() + middle, values.end());
+    if (n % 2) return values[middle];
+    const double lower = *std::max_element(values.begin(), values.begin() + middle);
+    return 0.5 * (lower + values[middle]);
+}
+
+}  // namespace spk::detail
