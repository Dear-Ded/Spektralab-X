+// Co-created with GPT (OpenAI), 2026-11-12. See NOTICE.
+// Same recurrence in finite-difference coordinates, for explicit triggs-v2.
+#pragma once
+#include <array>
+#include <cmath>
+
+namespace spk::detail {
+inline bool iir_difference_coeffs(const double b[4],float recurrence[8],float boundary[22]) {
+    const long double a1=b[1],a2=b[2],a3=b[3],g=b[0],dc=1-a1-a2-a3;
+    const long double scale=g/((1+a1-a2+a3)*dc*(1+a2+(a1-a3)*a3)),k=g/dc;
+    if(!(dc>0)||!std::isfinite(scale)||!std::isfinite(k))return false;
+    const auto store=[](float* out,long double v) {
+        out[0]=float(v);out[1]=float(v-static_cast<long double>(out[0]));
+        return std::isfinite(out[0])&&std::isfinite(out[1]);
+    };
+    if(!store(recurrence,g)||!store(recurrence+2,dc)||!store(recurrence+4,1+a2+2*a3)
+       ||!store(recurrence+6,1-a3))return false;
+    std::array<long double,3> row{(1-a2-a3*a1-a3*a3)*scale,
+        (a3+a1)*(a2+a3*a1)*scale,a3*(a1+a3*a2)*scale};
+    std::array<std::array<long double,3>,3> r{};
+    for(unsigned i=0;i<3;++i) {
+        row={row[0]*a1+row[1],row[0]*a2+row[2],row[0]*a3};r[i]=row;
+    }
+    // Input coordinates are [last, first backward difference, second difference].
+    // Reverse coordinates use [y(n+1), y(n+1)-y(n+2), y(n+1)-2y(n+2)+y(n+3)].
+    for(unsigned i=0;i<3;++i) {
+        for(unsigned j=0;j<3;++j)
+            row[j]=i==0?r[0][j]:i==1?r[0][j]-r[1][j]:r[0][j]-2*r[1][j]+r[2][j];
+        const std::array<long double,3> transformed{row[0]+row[1]+row[2],-row[1]-2*row[2],row[2]};
+        for(unsigned j=0;j<3;++j)if(!store(boundary+6*i+2*j,transformed[j]))return false;
+    }
+    return store(boundary+18,k)&&store(boundary+20,k*k);
+}
+} // namespace spk::detail
