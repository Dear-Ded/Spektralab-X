+#version 450
+#extension GL_GOOGLE_include_directive : require
+// Co-created with GPT (OpenAI), 2026-11-12. See NOTICE.
+// Explicit triggs-v2. Same filter and float32 plane, difference-coordinate state.
+layout(push_constant) uniform SpkDispatch { uint base; } spk_pc;
+#include "spk_split_product.glsl"
+layout(local_size_x = 256) in;
+layout(constant_id = 0) const bool SPK_FUSED_FMA = true;
+layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } image_data;
+layout(set = 0, binding = 1, std430) readonly buffer Coefficients { float value[]; } coefficients;
+layout(set = 0, binding = 2, std430) readonly buffer Active { uint value[]; } active_channels;
+layout(set = 0, binding = 3, std430) readonly buffer Accumulator { float value[]; } accumulator;
+layout(set = 0, binding = 4, std430) readonly buffer MixWeights { float value[]; } mix_weights;
+layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; } meta;
+layout(set = 0, binding = 6, std430) buffer Output { float value[]; } output_data;
+uint spk_global_index() {
+    return gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x+spk_pc.base;
+}
+vec2 two_sum(float a,float b) {
+    precise float s=a+b;precise float bb=s-a;precise float e=(a-(s-bb))+(b-bb);return vec2(s,e);
+}
+vec2 quick_two_sum(float a,float b) {
+    precise float s=a+b;precise float e=b-(s-a);return vec2(s,e);
+}
+vec2 two_prod(float a,float b) {
+    precise float p=a*b;
+    if(SPK_FUSED_FMA) {precise float e=fma(a,b,-p);return vec2(p,e);}
+    return spk_split_product(a,b);
+}
+vec2 df_add(vec2 a,vec2 b) {
+    vec2 s=two_sum(a.x,b.x),t=two_sum(a.y,b.y);precise float lo=s.y+t.x;
+    s=quick_two_sum(s.x,lo);precise float last=s.y+t.y;return quick_two_sum(s.x,last);
+}
+vec2 df_mul(vec2 a,vec2 b) {
+    vec2 p=two_prod(a.x,b.x);precise float cross_terms=a.x*b.y+a.y*b.x;
+    precise float lo=p.y+cross_terms;return quick_two_sum(p.x,lo);
+}
+vec2 df_mul_f(vec2 a,float b) {
+    vec2 p=two_prod(a.x,b);precise float lo=p.y+a.y*b;return quick_two_sum(p.x,lo);
+}
+vec2 coeff(uint i) {return vec2(coefficients.value[i],coefficients.value[i+1u]);}
+vec2 terminal(uint row,uint start,vec2 y,vec2 d,vec2 e) {
+    vec2 v=df_mul(coeff(start+row*6u),y);
+    v=df_add(v,df_mul(coeff(start+row*6u+2u),d));
+    return df_add(v,df_mul(coeff(start+row*6u+4u),e));
+}
+void advance(float x,vec2 g,vec2 dc,vec2 c1,vec2 c2,inout vec2 y,inout vec2 d,inout vec2 e) {
+    vec2 third=df_add(df_mul_f(g,x),-df_mul(dc,y));
+    third=df_add(third,-df_mul(c1,d));third=df_add(third,-df_mul(c2,e));
+    e=df_add(e,third);d=df_add(d,e);y=df_add(y,d);
+}
+void main() {
+    uint t=spk_global_index()+meta.value[4],h=meta.value[0],w=meta.value[1];
+    uint accumulate=meta.value[2],axis=meta.value[3],threads=axis==0u?w*3u:h*3u;
+    if(t>=min(threads,meta.value[5]))return;
+    uint c=t%3u,line=t/3u,length=axis==0u?h:w,stride=axis==0u?w*3u:3u;
+    uint base=axis==0u?line*3u+c:line*w*3u+c;
+    if(active_channels.value[c]==0u) {
+        for(uint i=0u;i<length;++i) {
+            uint ix=base+i*stride;precise float mixed=accumulator.value[ix]+mix_weights.value[c]*image_data.value[ix];
+            output_data.value[ix]=accumulate!=0u?mixed:image_data.value[ix];
+        }
+        return;
+    }
+    vec2 g=coeff(8u*c),dc=coeff(8u*c+2u),c1=coeff(8u*c+4u),c2=coeff(8u*c+6u);
+    uint start=24u+22u*c;
+    float endpoint=image_data.value[base+(length-1u)*stride];
+    vec2 y=df_mul_f(coeff(start+18u),image_data.value[base]),d=vec2(0),e=vec2(0);
+    for(uint i=0u;i<length;++i) {
+        advance(image_data.value[base+i*stride],g,dc,c1,c2,y,d,e);
+        output_data.value[base+i*stride]=y.x;
+    }
+    vec2 centred=df_add(y,-df_mul_f(coeff(start+18u),endpoint));
+    vec2 ry=df_add(terminal(0u,start,centred,d,e),df_mul_f(coeff(start+20u),endpoint));
+    vec2 rd=terminal(1u,start,centred,d,e),re=terminal(2u,start,centred,d,e);
+    for(int i=int(length)-1;i>=0;--i) {
+        uint ix=base+uint(i)*stride;advance(output_data.value[ix],g,dc,c1,c2,ry,rd,re);
+        precise float mixed=accumulator.value[ix]+mix_weights.value[c]*ry.x;
+        output_data.value[ix]=accumulate!=0u?mixed:ry.x;
+    }
+}
