+#pragma once
+// Co-created with GPT (OpenAI), 2026-11-13. See NOTICE.
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <utility>
+#include <vector>
+
+namespace spk::view::detail {
+// Receives the validated points from view_process.cpp. Tangent construction
+// and evaluation keep the original Fritsch-Carlson expression order.
+class PreparedCurve {
+public:
+    explicit PreparedCurve(std::vector<std::array<double, 2>> points)
+        : points_(std::move(points)), tangents_(points_.size()) {
+        const size_t n = points_.size();
+        std::vector<double> slopes(n - 1);
+        for (size_t i = 0; i + 1 < n; ++i)
+            slopes[i] = (points_[i + 1][1] - points_[i][1]) /
+                std::max(points_[i + 1][0] - points_[i][0], 1e-6);
+        tangents_[0] = slopes[0];
+        tangents_[n - 1] = slopes[n - 2];
+        for (size_t i = 1; i + 1 < n; ++i)
+            tangents_[i] = slopes[i - 1] * slopes[i] <= 0 ? 0 : (slopes[i - 1] + slopes[i]) / 2;
+        for (size_t i = 0; i + 1 < n; ++i) if (slopes[i] != 0) {
+            const double a = tangents_[i] / slopes[i], b = tangents_[i + 1] / slopes[i];
+            const double s = a * a + b * b;
+            if (s > 9) {
+                const double t = 3 / std::sqrt(s);
+                tangents_[i] = t * a * slopes[i];
+                tangents_[i + 1] = t * b * slopes[i];
+            }
+        }
+    }
+
+    double evaluate(double x) const {
+        const size_t n = points_.size();
+        if (x <= points_.front()[0]) return points_.front()[1];
+        if (x >= points_.back()[0]) return points_.back()[1];
+        size_t i = 0;
+        while (i < n - 2 && x > points_[i + 1][0]) ++i;
+        const double h = std::max(points_[i + 1][0] - points_[i][0], 1e-6);
+        const double t = (x - points_[i][0]) / h, t2 = t * t, t3 = t2 * t;
+        return std::clamp((2 * t3 - 3 * t2 + 1) * points_[i][1] +
+            (t3 - 2 * t2 + t) * h * tangents_[i] + (-2 * t3 + 3 * t2) * points_[i + 1][1] +
+            (t3 - t2) * h * tangents_[i + 1], 0.0, 1.0);
+    }
+private:
+    std::vector<std::array<double, 2>> points_;
+    std::vector<double> tangents_;
+};
+} // namespace spk::view::detail
