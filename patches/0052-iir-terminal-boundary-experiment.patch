index 0000000..daa8a9e
--- /dev/null
+++ b/engine/src/pipeline/iir_boundary.hpp
@@ -0,0 +1,31 @@
+// Co-created with GPT (OpenAI), 2026-11-12. See NOTICE.
+// Triggs/Sdika constant-extension states; diagnostic Vulkan mode only.
+#pragma once
+#include <array>
+#include <cmath>
+
+namespace spk::detail {
+inline bool iir_boundary_coeffs(const double b[4], float out[22]) {
+    const long double a1=b[1], a2=b[2], a3=b[3], gain=b[0];
+    const long double dc=1-a1-a2-a3;
+    const long double scale=gain/((1+a1-a2+a3)*dc*(1+a2+(a1-a3)*a3));
+    const long double ratio=gain/dc;
+    if (!(dc > 0) || !std::isfinite(scale) || !std::isfinite(ratio)) return false;
+    std::array<long double,3> row{(1-a2-a3*a1-a3*a3)*scale,
+                                 (a3+a1)*(a2+a3*a1)*scale,
+                                 a3*(a1+a3*a2)*scale};
+    const auto store=[&](unsigned index, long double value) {
+        const double d=double(value);
+        const float hi=float(d), lo=float(d-double(hi));
+        out[index]=hi; out[index+1]=lo;
+        return std::isfinite(hi) && std::isfinite(lo);
+    };
+    // Rows map the last forward states to reverse states n+1, n+2, n+3.
+    for (unsigned i=0; i<3; ++i) {
+        row={row[0]*a1+row[1], row[0]*a2+row[2], row[0]*a3};
+        for (unsigned j=0; j<3; ++j)
+            if (!store(6*i+2*j,row[j])) return false;
+    }
+    return store(18,ratio) && store(20,ratio*ratio);
+}
+}  // namespace spk::detail
