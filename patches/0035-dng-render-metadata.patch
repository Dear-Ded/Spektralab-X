+// Main DNG profile rendering intent, retained without applying it to scene RGB.
+// Missing exposure fields default to zero; missing black render defaults Auto.
+// Invalid/present are distinct so a developed path cannot silently use fallback
+// for a malformed explicit tag. Extra profiles and mixed profile IFDs require
+// an explicit unsupported policy rather than combining unrelated calibration.
+struct RawDngRenderMetadata {
+    bool is_dng = false;
+    bool baseline_exposure_present = false, baseline_exposure_invalid = false;
+    double baseline_exposure = 0.0;
+    bool baseline_exposure_offset_present = false, baseline_exposure_offset_invalid = false;
+    double baseline_exposure_offset = 0.0;
+    bool default_black_render_present = false, default_black_render_invalid = false;
+    std::uint32_t default_black_render = 0;
+    bool profile_tone_curve_present = false, profile_tone_curve_invalid = false;
+    std::vector<std::array<float, 2>> profile_tone_curve;
+    bool extra_camera_profiles = false;
+    bool profile_source_mismatch = false;
+};
+
 struct RawMetadata {
+    RawDngRenderMetadata dng_render;
     std::string libraw_version;
     std::uint32_t libraw_capabilities = 0;
     std::string make, model, decoder_name;
