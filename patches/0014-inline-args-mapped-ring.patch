+    // Android: one small host-visible storage buffer, mapped for the backend's
+    // life, that carries every dispatch's inline arguments (Arg::inline_bytes:
+    // meta counts, matrices, LUT ranges). Without it each such argument was a
+    // pooled device buffer filled through staging with a submit and a queue
+    // wait of its own, before the dispatch's own submit. A device without a
+    // suitable memory type, or SPEKTRAFILM_VULKAN_INLINE_RING=0, keeps the old
+    // path; nothing fails because the ring is missing.
+    void create_inline_ring() {
+        if (const char* v = std::getenv("SPEKTRAFILM_VULKAN_INLINE_RING"); v && std::strcmp(v, "0") == 0) return;
+        Buffer& b = inline_ring_;
+        b.bytes = b.requested_bytes = kInlineRingBytes;
+        VkBufferCreateInfo create{};
+        create.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        create.size = VkDeviceSize(b.bytes);
+        create.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+        create.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        if (vkCreateBuffer(device_, &create, nullptr, &b.handle) != VK_SUCCESS) { b.handle = VK_NULL_HANDLE; return; }
+        VkMemoryRequirements requirements{};
+        vkGetBufferMemoryRequirements(device_, b.handle, &requirements);
+        uint32_t memory_index = UINT32_MAX;
+        int best_score = -1;
+        for (uint32_t i = 0; i < memory_properties_.memoryTypeCount; ++i) {
+            const auto flags = memory_properties_.memoryTypes[i].propertyFlags;
+            if (!(requirements.memoryTypeBits & (1u << i)) || !(flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)) continue;
+            int score = 0;
+            if (flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) score += 4;
+            if (flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) score += 2;   // UMA (Adreno), or a BAR
+            if (score > best_score) { memory_index = i; best_score = score; }
+        }
+        if (memory_index == UINT32_MAX) { destroy_buffer(&b); return; }
+        VkMemoryAllocateInfo allocate_info{};
+        allocate_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        allocate_info.allocationSize = requirements.size;
+        allocate_info.memoryTypeIndex = memory_index;
+        b.memory_type = memory_index;
+        b.memory_flags = memory_properties_.memoryTypes[memory_index].propertyFlags;
+        b.allocation_bytes = requirements.size;
+        if (vkAllocateMemory(device_, &allocate_info, nullptr, &b.memory) != VK_SUCCESS) {
+            b.memory = VK_NULL_HANDLE; destroy_buffer(&b); return;
+        }
+        if (vkBindBufferMemory(device_, b.handle, b.memory, 0) != VK_SUCCESS ||
+            vkMapMemory(device_, b.memory, 0, VK_WHOLE_SIZE, 0, &b.mapped) != VK_SUCCESS) {
+            b.mapped = nullptr; destroy_buffer(&b); return;
+        }
+    }
+
+    size_t inline_ring_alignment() const {
+        return std::max<size_t>(4, size_t(properties_.limits.minStorageBufferOffsetAlignment));
+    }
