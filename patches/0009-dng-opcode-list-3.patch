index 0000000..db542e7
--- /dev/null
+++ b/engine/src/io/dng_opcode_list3.hpp
@@ -0,0 +1,221 @@
+#pragma once
+// DNG OpcodeList3: WarpRectilinear (opcode 1, lens distortion and lateral
+// chromatic aberration, Leica) and FixVignetteRadial (opcode 3, radial
+// vignetting, iPhone). LibRaw 0.22.2 reads the list into
+// dng_levels.rawopcodes[2] and applies none of it without the Adobe DNG SDK.
+//
+// OpcodeList3 works on the stage-3 image: demosaiced camera RGB before the
+// colour transform. In LibRaw that is imgdata.image just before
+// convert_to_rgb(), which is where CameraLibRaw calls this (the
+// pre_converttorgb callback): black taken off, scaled to 0..65535, still in
+// sensor orientation and in the active area, as the opcodes expect.
+//
+// The arithmetic follows the DNG SDK (dng_lens_correction.cpp):
+// - WarpRectilinear: dng_filter_warp::GetSrcPixelPosition. Centre at
+//   cx * width, cy * height; radius normalised by the farthest image corner;
+//   r^2 capped at 1; radial ratio kr0 + kr1 r^2 + kr2 r^4 + kr3 r^6, then the
+//   tangential terms; destination positions are integer pixel coordinates.
+//   Resampled with the SDK's bicubic kernel (A = -0.75, 32 subsample steps,
+//   edge pixels repeated). Planes past the ones given reuse plane 0.
+// - FixVignetteRadial: dng_opcode_FixVignetteRadial::Prepare. Radius
+//   normalised by the farthest edge in each axis, pixel centres at +0.5,
+//   gain 1 + k0 r^2 + k1 r^4 + k2 r^6 + k3 r^8 + k4 r^10.
+// Values clip at 65535 (the SDK's Pin to 1.0).
+//
+// The whole list is parsed and validated first: a list that is truncated,
+// has a parameter block of the wrong size or a non-finite value, or a centre
+// outside the image, changes no pixel. Other opcodes are skipped whether
+// optional or not; this is not a DNG renderer and the picture is still useful.
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace spk::io::detail {
+
+namespace ol3_detail {
+inline std::uint32_t be32(const unsigned char* p) {
+    return std::uint32_t(p[0]) << 24 | std::uint32_t(p[1]) << 16 | std::uint32_t(p[2]) << 8 | p[3];
+}
+inline double be_double(const unsigned char* p) {
+    std::uint64_t v = 0;
+    for (int i = 0; i < 8; ++i) v = v << 8 | p[i];
+    double d;
+    std::memcpy(&d, &v, sizeof d);
+    return d;
+}
+
+struct Op {
+    std::uint32_t id = 0;
+    std::uint32_t planes = 0;  // WarpRectilinear
+    double k[4][6] = {};       // per plane: kr0..kr3, kt0, kt1 (warp); k0..k4 (vignette, plane 0)
+    double cx = 0.5, cy = 0.5;
+};
+
+inline bool centre_ok(double cx, double cy) {
+    return std::isfinite(cx) && std::isfinite(cy) && cx >= 0 && cx <= 1 && cy >= 0 && cy <= 1;
+}
+
+// The SDK's 4-tap bicubic (dng_resample_bicubic), normalised, for 32 subsample positions.
+struct Bicubic {
+    float w[32][4];
+    Bicubic() {
+        auto kernel = [](double x) {
+            const double A = -0.75;
+            x = std::fabs(x);
+            if (x >= 2.0) return 0.0;
+            if (x >= 1.0) return ((A * x - 5.0 * A) * x + 8.0 * A) * x - 4.0 * A;
+            return ((A + 2.0) * x - (A + 3.0)) * x * x + 1.0;
+        };
+        for (int s = 0; s < 32; ++s) {
+            const double f = s / 32.0;
+            double t = 0, v[4];
+            for (int j = 0; j < 4; ++j) t += v[j] = kernel(j - 1 - f);
+            for (int j = 0; j < 4; ++j) w[s][j] = float(v[j] / t);
+        }
+    }
+};
+
+inline bool is_nop_warp(const Op& op) {
+    for (std::uint32_t p = 0; p < op.planes; ++p) {
+        const double* k = op.k[p];
+        if (k[0] != 1.0 || k[1] != 0.0 || k[2] != 0.0 || k[3] != 0.0 || k[4] != 0.0 || k[5] != 0.0) return false;
+    }
+    return true;
+}
+
+inline void warp(std::uint16_t (*image)[4], std::uint32_t width, std::uint32_t height, int colors, const Op& op) {
+    static const Bicubic bicubic;
+    const double ch = op.cx * width, cv = op.cy * height;
+    const double radius = std::sqrt(std::max({cv * cv + ch * ch, cv * cv + (width - ch) * (width - ch),
+                                              (height - cv) * (height - cv) + ch * ch,
+                                              (height - cv) * (height - cv) + (width - ch) * (width - ch)}));
+    if (!(radius > 0)) return;
+    const double inv = 1.0 / radius;
+    std::vector<std::uint16_t> src(std::size_t(width) * height);
+    for (int c = 0; c < colors; ++c) {
+        for (std::size_t i = 0; i < src.size(); ++i) src[i] = image[i][c];
+        const double* k = op.k[std::uint32_t(c) < op.planes ? c : 0];
+        const long long rows = height;
+#if defined(_OPENMP)
+#pragma omp parallel for schedule(static)
+#endif
+        for (long long row = 0; row < rows; ++row) {
+            for (std::uint32_t col = 0; col < width; ++col) {
+                const double dv = (double(row) - cv) * inv, dh = (double(col) - ch) * inv;
+                const double dvdv = dv * dv, dhdh = dh * dh;
+                const double rr = std::min(dvdv + dhdh, 1.0);
+                const double ratio = k[0] + rr * (k[1] + rr * (k[2] + rr * k[3]));
+                const double tv = k[4] * (rr + 2.0 * dvdv) + 2.0 * k[5] * dh * dv;
+                const double th = k[5] * (rr + 2.0 * dhdh) + 2.0 * k[4] * dh * dv;
+                double sv = cv + radius * (dv * ratio + tv);
+                double sh = ch + radius * (dh * ratio + th);
+                if (!std::isfinite(sv) || !std::isfinite(sh)) sv = double(row), sh = col;
+                sv = std::clamp(sv, 0.0, double(height - 1));
+                sh = std::clamp(sh, 0.0, double(width - 1));
+                const int iv = int(std::floor(sv)), ih = int(std::floor(sh));
+                const int fv = std::min(31, int((sv - iv) * 32)), fh = std::min(31, int((sh - ih) * 32));
+                const float* wv = bicubic.w[fv];
+                const float* wh = bicubic.w[fh];
+                int xs[4];
+                for (int j = 0; j < 4; ++j) xs[j] = std::clamp(ih - 1 + j, 0, int(width) - 1);
+                float total = 0;
+                for (int i = 0; i < 4; ++i) {
+                    const int y = std::clamp(iv - 1 + i, 0, int(height) - 1);
+                    const std::uint16_t* line = src.data() + std::size_t(y) * width;
+                    float acc = 0;
+                    for (int j = 0; j < 4; ++j) acc += wh[j] * line[xs[j]];
+                    total += wv[i] * acc;
+                }
+                image[std::size_t(row) * width + col][c] =
+                    std::uint16_t(std::lround(std::clamp(total, 0.0f, 65535.0f)));
+            }
+        }
+    }
+}
+
+inline void vignette(std::uint16_t (*image)[4], std::uint32_t width, std::uint32_t height, int colors, const Op& op) {
+    const double ch = op.cx * width, cv = op.cy * height;
+    const double radius = std::hypot(std::max(cv, height - cv), std::max(ch, width - ch));
+    if (!(radius > 0)) return;
+    const double* k = op.k[0];
+    const long long rows = height;
+#if defined(_OPENMP)
+#pragma omp parallel for schedule(static)
+#endif
+    for (long long row = 0; row < rows; ++row) {
+        const double y = (double(row) + 0.5 - cv) / radius;
+        for (std::uint32_t col = 0; col < width; ++col) {
+            const double x = (double(col) + 0.5 - ch) / radius;
+            const double r2 = std::min(x * x + y * y, 1.0);
+            const double gain = 1.0 + r2 * (k[0] + r2 * (k[1] + r2 * (k[2] + r2 * (k[3] + r2 * k[4]))));
+            if (!std::isfinite(gain) || gain == 1.0) continue;
+            auto& px = image[std::size_t(row) * width + col];
+            for (int c = 0; c < colors; ++c)
+                px[c] = std::uint16_t(std::lround(std::clamp(px[c] * gain, 0.0, 65535.0)));
+        }
+    }
+}
+}  // namespace ol3_detail
+
+// Applies OpcodeList3 (`data`, `len` bytes, big-endian as stored) to `image`
+// (width x height pixels, channels 0..colors-1 used). Returns how many
+// opcodes changed the image; 0 when there is nothing to do or the list is
+// malformed, and then no pixel is touched.
+inline int apply_dng_opcode_list3(std::uint16_t (*image)[4], std::uint32_t width, std::uint32_t height,
+                                  int colors, const void* data, std::size_t len) {
+    using namespace ol3_detail;
+    if (!image || !data || len < 4 || width < 2 || height < 2 || colors < 1 || colors > 3) return 0;
+    const auto* b = static_cast<const unsigned char*>(data);
+    const std::uint32_t count = be32(b);
+    if (count > 256) return 0;
+    std::vector<Op> ops;
+    std::size_t p = 4;
+    for (std::uint32_t n = 0; n < count; ++n) {
+        if (len - p < 16) return 0;
+        const std::uint32_t id = be32(b + p), bytes = be32(b + p + 12);
+        p += 16;
+        if (bytes > len - p) return 0;
+        const unsigned char* q = b + p;
+        if (id == 1) {  // WarpRectilinear
+            if (bytes < 4) return 0;
+            Op op;
+            op.id = 1;
+            op.planes = be32(q);
+            if (op.planes < 1 || op.planes > 4 || bytes != 4 + op.planes * 48 + 16) return 0;
+            for (std::uint32_t pl = 0; pl < op.planes; ++pl)
+                for (int i = 0; i < 6; ++i) {
+                    op.k[pl][i] = be_double(q + 4 + (pl * 6 + i) * 8);
+                    if (!std::isfinite(op.k[pl][i])) return 0;
+                }
+            op.cx = be_double(q + 4 + op.planes * 48);
+            op.cy = be_double(q + 4 + op.planes * 48 + 8);
+            if (!centre_ok(op.cx, op.cy)) return 0;
+            if (!is_nop_warp(op)) ops.push_back(op);
+        } else if (id == 3) {  // FixVignetteRadial
+            if (bytes != 56) return 0;
+            Op op;
+            op.id = 3;
+            bool nop = true;
+            for (int i = 0; i < 5; ++i) {
+                op.k[0][i] = be_double(q + i * 8);
+                if (!std::isfinite(op.k[0][i])) return 0;
+                nop &= op.k[0][i] == 0.0;
+            }
+            op.cx = be_double(q + 40);
+            op.cy = be_double(q + 48);
+            if (!centre_ok(op.cx, op.cy)) return 0;
+            if (!nop) ops.push_back(op);
+        }
+        p += bytes;
+    }
+    for (const auto& op : ops) {
+        if (op.id == 1) warp(image, width, height, colors, op);
+        else vignette(image, width, height, colors, op);
+    }
+    return int(ops.size());
+}
+
+}  // namespace spk::io::detail
