diff --git a/engine/tests/dng_opcode_list3.cpp b/engine/tests/dng_opcode_list3.cpp
new file mode 100644
index 0000000..a6d328d
--- /dev/null
+++ b/engine/tests/dng_opcode_list3.cpp
@@ -0,0 +1,131 @@
+// DNG OpcodeList3 (dng_opcode_list3.hpp): a malformed list leaves every pixel
+// alone, a no-op list too, and the two opcodes move pixels as the DNG SDK does.
+#include "../src/io/dng_opcode_list3.hpp"
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace {
+void put32(std::vector<unsigned char>& b, std::uint32_t v) {
+    for (int s = 24; s >= 0; s -= 8) b.push_back(static_cast<unsigned char>(v >> s));
+}
+void put_double(std::vector<unsigned char>& b, double d) {
+    std::uint64_t v;
+    std::memcpy(&v, &d, sizeof v);
+    for (int s = 56; s >= 0; s -= 8) b.push_back(static_cast<unsigned char>(v >> s));
+}
+void header(std::vector<unsigned char>& b, std::uint32_t id, std::uint32_t flags, std::uint32_t bytes) {
+    put32(b, id); put32(b, 0x01030000); put32(b, flags); put32(b, bytes);
+}
+std::vector<unsigned char> vignette_list(const double k[5], double cx = 0.5, double cy = 0.5) {
+    std::vector<unsigned char> b;
+    put32(b, 1);
+    header(b, 3, 0, 56);
+    for (int i = 0; i < 5; ++i) put_double(b, k[i]);
+    put_double(b, cx); put_double(b, cy);
+    return b;
+}
+std::vector<unsigned char> warp_list(std::uint32_t planes, const double k[6], double cx = 0.5, double cy = 0.5) {
+    std::vector<unsigned char> b;
+    put32(b, 1);
+    header(b, 1, 1, 4 + planes * 48 + 16);
+    put32(b, planes);
+    for (std::uint32_t p = 0; p < planes; ++p)
+        for (int i = 0; i < 6; ++i) put_double(b, k[i]);
+    put_double(b, cx); put_double(b, cy);
+    return b;
+}
+
+constexpr std::uint32_t W = 64, H = 48;
+std::vector<std::uint16_t> make() {
+    std::vector<std::uint16_t> px(std::size_t(W) * H * 4);
+    for (std::uint32_t y = 0; y < H; ++y)
+        for (std::uint32_t x = 0; x < W; ++x)
+            for (int c = 0; c < 4; ++c)
+                px[(std::size_t(y) * W + x) * 4 + c] = std::uint16_t(1000 + 300 * x + 200 * y + 50 * c);
+    return px;
+}
+int run(std::vector<std::uint16_t>& px, const std::vector<unsigned char>& list) {
+    return spk::io::detail::apply_dng_opcode_list3(reinterpret_cast<std::uint16_t(*)[4]>(px.data()), W, H, 3,
+                                                   list.data(), list.size());
+}
+int fail(int code, const char* what) {
+    std::fprintf(stderr, "dng_opcode_list3: %s\n", what);
+    return code;
+}
+}  // namespace
+
+int main() {
+    const auto original = make();
+    const double vig[5] = {0.5, 0.25, 0, 0, 0};
+
+    // Malformed lists: nothing changes.
+    {
+        auto good = vignette_list(vig);
+        std::vector<std::vector<unsigned char>> bad;
+        bad.push_back({0, 0, 0});                                     // shorter than the count
+        bad.push_back(std::vector<unsigned char>(good.begin(), good.end() - 1));  // truncated parameters
+        auto big = good; big[4 + 15] = 57; bad.push_back(big);        // wrong parameter size
+        auto many = good; many[3] = 2; bad.push_back(many);           // count past the data
+        auto off = vignette_list(vig, 1.5, 0.5); bad.push_back(off);  // centre outside the image
+        const double nan[5] = {NAN, 0, 0, 0, 0};
+        bad.push_back(vignette_list(nan));                            // non-finite coefficient
+        const double wk[6] = {1, -0.05, 0, 0, 0, 0};
+        auto w5 = warp_list(1, wk); w5[4 + 16 + 3] = 5; bad.push_back(w5);  // 5 planes
+        // A good vignette followed by a broken one: the good one is not applied either.
+        auto two = good; two[3] = 2;
+        header(two, 3, 0, 56); for (int i = 0; i < 3; ++i) put_double(two, 0.1);
+        bad.push_back(two);
+        for (const auto& list : bad) {
+            auto px = original;
+            if (run(px, list) != 0 || px != original) return fail(1, "a malformed list changed pixels");
+        }
+    }
+    // The Xiaomi lists: an empty one (count 0) and an identity warp.
+    {
+        auto px = original;
+        const std::vector<unsigned char> empty = {0, 0, 0, 0};
+        const double id[6] = {1, 0, 0, 0, 0, 0};
+        if (run(px, empty) != 0 || run(px, warp_list(1, id, 0, 0)) != 0 || px != original)
+            return fail(2, "a no-op list changed pixels");
+    }
+    // An unknown opcode is skipped, the vignette after it still applies.
+    {
+        std::vector<unsigned char> list;
+        put32(list, 2);
+        header(list, 7, 0, 8); put32(list, 0); put32(list, 0);
+        const auto v = vignette_list(vig);
+        list.insert(list.end(), v.begin() + 4, v.end());
+        auto px = original;
+        if (run(px, list) != 1) return fail(3, "unknown opcode not skipped");
+    }
+    // FixVignetteRadial: the centre is (almost) untouched, corners gain 1 + k0 + k1.
+    {
+        auto px = original;
+        if (run(px, vignette_list(vig)) != 1) return fail(4, "vignette not applied");
+        const std::size_t corner = 0, centre = (std::size_t(H / 2) * W + W / 2) * 4;
+        const double rc = std::hypot((0.5 - H / 2.0) / std::hypot(H / 2.0, W / 2.0),
+                                     (0.5 - W / 2.0) / std::hypot(H / 2.0, W / 2.0));
+        const double r2 = rc * rc, expect = original[corner] * (1 + r2 * (0.5 + r2 * 0.25));
+        if (std::fabs(px[corner] - expect) > 1.0) return fail(5, "vignette corner gain");
+        if (std::abs(int(px[centre]) - int(original[centre])) > original[centre] / 1000) return fail(6, "vignette centre moved");
+        if (px[corner + 3] != original[corner + 3]) return fail(7, "fourth channel touched");
+    }
+    // WarpRectilinear: a pure scale (kr0 = 0.5) samples halfway to the centre.
+    {
+        std::vector<std::uint16_t> px(std::size_t(W) * H * 4);
+        for (std::uint32_t y = 0; y < H; ++y)
+            for (std::uint32_t x = 0; x < W; ++x)
+                for (int c = 0; c < 3; ++c) px[(std::size_t(y) * W + x) * 4 + c] = std::uint16_t(100 * x);
+        const double k[6] = {0.5, 0, 0, 0, 0, 0};
+        if (run(px, warp_list(1, k)) != 1) return fail(8, "warp not applied");
+        // Destination column 0 reads source column W/2 * 0.5 = 16 (a linear ramp survives bicubic).
+        const std::size_t at = (std::size_t(H / 2) * W + 0) * 4;
+        if (std::abs(int(px[at]) - 1600) > 2) return fail(9, "warp sample position");
+        if (std::abs(int(px[(std::size_t(H / 2) * W + W / 2) * 4]) - 3200) > 2) return fail(10, "warp centre");
+    }
+    std::puts("dng_opcode_list3: malformed, no-op, vignette and warp cases passed");
+    return 0;
+}
