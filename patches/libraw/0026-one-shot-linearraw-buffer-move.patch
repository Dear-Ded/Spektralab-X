+      IO.shrink || IO.fuji_width || S.pixel_aspect != 1.0 ||
+      S.left_margin || S.top_margin || !S.width || !S.height ||
+      S.width != S.raw_width || S.height != S.raw_height ||
+      S.iwidth != S.width || S.iheight != S.height ||
