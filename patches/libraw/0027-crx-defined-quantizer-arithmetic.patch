+static bool crxQuantizationScale(int64_t qp, uint32_t &scale)
+{
+  const int64_t quotient = qp / 6;
+  const uint32_t value = q_step_tbl[qp < 0 ? 0 : qp % 6];
+  if (quotient < 6)
+  {
+    const int64_t shift = 6 - quotient;
+    scale = shift >= 32 ? 0 : value >> shift;
+  }
+  else
+  {
+    const int64_t shift = quotient - 6;
+    if (shift >= 32 || value > (UINT32_MAX >> shift))
+      return false;
+    scale = value << shift;
+  }
+  return true;
+}
