LibRaw 0.22.2: ljpeg_idct() fills its static cosine table on first use
(`if (!cs[0]) FORC(106) cs[c] = ...`). With OpenMP two threads can race on
it, one reading entries the other has not written yet. Build the table once
through a function-local static, which C++11 initialises exactly once.

Same fix as thetechgeekko/Spektrafilm-android lib/libraw/patches/0017
(GPL-3.0), written here without std::vector.

--- a/src/decoders/decoders_dcraw.cpp
+++ b/src/decoders/decoders_dcraw.cpp
@@ -768,7 +768,18 @@
 {
   int c, i, j, len, skip, coef;
   float work[3][8][8];
-  static float cs[106] = {0};
+  // Built once, before any caller can read it (C++11 static initialization),
+  // instead of filled on first use by whichever thread gets there first.
+  static const struct idct_table
+  {
+    float v[106];
+    idct_table()
+    {
+      for (int k = 0; k < 106; k++)
+        v[k] = float(cos((k & 31) * M_PI / 16) / 2);
+    }
+  } cs_table;
+  const float *cs = cs_table.v;
   static const uchar zigzag[80] = {
       0,  1,  8,  16, 9,  2,  3,  10, 17, 24, 32, 25, 18, 11, 4,  5,
       12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6,  7,  14, 21, 28,
@@ -776,8 +787,6 @@
       58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63,
       63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63, 63};
 
-  if (!cs[0])
-    FORC(106) cs[c] = float(cos((c & 31) * M_PI / 16) / 2);
   memset(work, 0, sizeof work);
   work[0][0][0] = float(jh->vpred[0] += ljpeg_diff(jh->huff[0]) * jh->quant[0]);
   for (i = 1; i < 64; i++)
