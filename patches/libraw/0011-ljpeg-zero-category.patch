From thetechgeekko/Spektrafilm-android lib/libraw/patches/0003-ljpeg-zero-category.patch (GPL-3.0),
unchanged apart from this header (sha256 of the original: 4330ad0c8ef7a996...).
LibRaw itself is LGPL-2.1/CDDL; this hardening applies to 0.22.2.

diff --git a/src/decoders/decoders_dcraw.cpp b/src/decoders/decoders_dcraw.cpp
--- a/src/decoders/decoders_dcraw.cpp
+++ b/src/decoders/decoders_dcraw.cpp
@@ -365,6 +365,10 @@ int LibRaw::ljpeg_diff(ushort *huff)
     throw LIBRAW_EXCEPTION_IO_CORRUPT;
 
   len = gethuff(huff);
+  if (len == 0)
+    return 0;
+  if (len < 0 || len > 16)
+    throw LIBRAW_EXCEPTION_IO_CORRUPT;
   if (len == 16 && (!dng_version || dng_version >= 0x1010000))
     return -32768;
   diff = getbits(len);
