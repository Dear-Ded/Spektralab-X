+bool LibRaw::spk_release_rawdata()
+{
+  // Co-created with GPT (OpenAI). Use the same owner/allocator as recycle();
+  // never free RawSpeed-owned storage or the processed working image.
+  if (!(imgdata.progress_flags & LIBRAW_PROGRESS_CONVERT_RGB) || !imgdata.image ||
+      (imgdata.process_warnings &
+       (LIBRAW_WARN_RAWSPEED_PROCESSED | LIBRAW_WARN_RAWSPEED3_PROCESSED)) ||
+      !imgdata.rawdata.raw_alloc || imgdata.rawdata.raw_alloc == imgdata.image)
+    return false;
+
+  free(imgdata.rawdata.raw_alloc);
+  imgdata.rawdata.raw_alloc = NULL;
+  imgdata.rawdata.raw_image = NULL;
+  imgdata.rawdata.color3_image = NULL;
+  imgdata.rawdata.color4_image = NULL;
+  imgdata.rawdata.float_image = NULL;
+  imgdata.rawdata.float3_image = NULL;
+  imgdata.rawdata.float4_image = NULL;
+  return true;
+}
