+
+// main d4b8145 Decode curve: gain on stops around metered mid-grey.
+// Read at E + film EV; node_exposure still applies the final exposure gain.
+inline float scene_curve_gain(float v, device const float* t, uint row, uint n, float S, float n_ref, float c) {
+    if (!(v > 0.0f) || !isfinite(v)) return 1.0f;
+    float E = log2(v / n_ref) + c;
+    float u = clamp((E + S) / (2.0f * S), 0.0f, 1.0f);
+    float x = u * float(n - 1u);
+    uint i = min(uint(x), n - 2u);
+    float f = x - float(i);
+    device const float* r = t + row * n;
+    float y = mix(r[i], r[i + 1u], f);
+    float d = 2.0f * S * (y - u);
+    return clamp(exp2(d), exp2(-30.0f), exp2(30.0f));
+}
+
+kernel void spk_scene_curve(device const float* rgb [[buffer(0)]],
+                            device const float* p [[buffer(1)]],
+                            device const float* t [[buffer(2)]],
+                            device const uint* count [[buffer(3)]],
+                            device float* out [[buffer(4)]],
+                            uint3 thread_position_in_grid [[thread_position_in_grid]]) {
+    uint i = thread_position_in_grid.x;
+    if (i >= count[0]) return;
+    uint n = uint(p[0]);
+    float S = p[1], n_ref = p[2], ec = p[6];
+    float3 c = float3(rgb[3u * i], rgb[3u * i + 1u], rgb[3u * i + 2u]);
+    float y = p[3] * max(c.r, 0.0f) + p[4] * max(c.g, 0.0f) + p[5] * max(c.b, 0.0f);
+    c *= scene_curve_gain(y, t, 1u, n, S, n_ref, ec);
+    c = float3(c.r * scene_curve_gain(c.r, t, 0u, n, S, n_ref, ec),
+               c.g * scene_curve_gain(c.g, t, 0u, n, S, n_ref, ec),
+               c.b * scene_curve_gain(c.b, t, 0u, n, S, n_ref, ec));
+    c = float3(c.r * scene_curve_gain(c.r, t, 2u, n, S, n_ref, ec),
+               c.g * scene_curve_gain(c.g, t, 3u, n, S, n_ref, ec),
+               c.b * scene_curve_gain(c.b, t, 4u, n, S, n_ref, ec));
+    out[3u * i] = c.r;
+    out[3u * i + 1u] = c.g;
+    out[3u * i + 2u] = c.b;
+}
diff --git a/engine/src/shaders/vulkan/spk_scene_curve.comp b/engine/src/shaders/vulkan/spk_scene_curve.comp
new file mode 100644
index 0000000..8f4d962
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_scene_curve.comp
@@ -0,0 +1,42 @@
+#version 450
+
+// From main d4b8145 scene_latitude.metal. The table changes positive gains,
+// not the signal's sign. Luma, RGB, then individual channel rows, in order.
+layout(push_constant) uniform SpkDispatch { uint base; } spk_pc;
+layout(local_size_x = 256) in;
+layout(set = 0, binding = 0, std430) readonly buffer Input { float v[]; } rgb;
+layout(set = 0, binding = 1, std430) readonly buffer Parameters { float v[]; } p;
+layout(set = 0, binding = 2, std430) readonly buffer Table { float v[]; } t;
+layout(set = 0, binding = 3, std430) readonly buffer Count { uint v[]; } count;
+layout(set = 0, binding = 4, std430) writeonly buffer Output { float v[]; } dst;
+
+float gain(float v, uint row, uint n, float S, float ref, float ev) {
+    if (!(v > 0.0) || isnan(v) || isinf(v)) return 1.0;
+    precise float E = log2(v / ref) + ev;
+    precise float u = clamp((E + S) / (2.0 * S), 0.0, 1.0);
+    precise float x = u * float(n - 1u);
+    uint i = min(uint(x), n - 2u);
+    precise float f = x - float(i);
+    precise float y = mix(t.v[row * n + i], t.v[row * n + i + 1u], f);
+    precise float d = 2.0 * S * (y - u);
+    return clamp(exp2(d), exp2(-30.0), exp2(30.0));
+}
+
+void main() {
+    uint i = gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x + spk_pc.base;
+    if (i >= count.v[0]) return;
+    uint n = uint(p.v[0]);
+    float S = p.v[1], ref = p.v[2], ev = p.v[6];
+    precise vec3 c = vec3(rgb.v[3u * i], rgb.v[3u * i + 1u], rgb.v[3u * i + 2u]);
+    precise float y = p.v[3] * max(c.r, 0.0) + p.v[4] * max(c.g, 0.0) + p.v[5] * max(c.b, 0.0);
+    c *= gain(y, 1u, n, S, ref, ev);
+    c = vec3(c.r * gain(c.r, 0u, n, S, ref, ev),
+             c.g * gain(c.g, 0u, n, S, ref, ev),
+             c.b * gain(c.b, 0u, n, S, ref, ev));
+    c = vec3(c.r * gain(c.r, 2u, n, S, ref, ev),
+             c.g * gain(c.g, 3u, n, S, ref, ev),
+             c.b * gain(c.b, 4u, n, S, ref, ev));
+    dst.v[3u * i] = c.r;
+    dst.v[3u * i + 1u] = c.g;
+    dst.v[3u * i + 2u] = c.b;
+}
