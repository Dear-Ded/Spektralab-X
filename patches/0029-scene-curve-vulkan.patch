+bool parse_scene_curve(const std::string& text, std::vector<float>& table, size_t& n, std::string& error) {
+    table.clear();
+    n = 0;
+    if (text.empty()) return true;
+    const auto reject = [&](const char* why) {
+        table.clear();
+        error = why;
+        return false;
+    };
+    if (text.size() > 1024 * 1024 || text.find('\0') != std::string::npos)
+        return reject("'scene_curve' is too long or contains a NUL byte");
+    const char* p = text.c_str();
+    while (*p) {
+        char* end = nullptr;
+        const double v = std::strtod(p, &end);
+        if (end == p || !std::isfinite(v) || v < 0.0 || v > 1.0)
+            return reject("'scene_curve' must be comma-separated numbers in 0..1");
+        if (table.size() == kSceneCurveRows * kSceneCurveMaxSamples)
+            return reject("'scene_curve' supports at most 4096 samples per row");
+        table.push_back(float(v));
+        p = end;
+        if (*p == ',') {
+            ++p;
+            if (!*p) return reject("'scene_curve' must not end with a comma");
+        } else if (*p) {
+            return reject("'scene_curve' must be comma-separated numbers in 0..1");
+        }
+    }
+    if (table.size() % kSceneCurveRows != 0 || table.size() / kSceneCurveRows < 2)
+        return reject("'scene_curve' must hold five rows of at least two samples (rgb, luma, r, g, b)");
+    n = table.size() / kSceneCurveRows;
+    return true;
+}
