+    // EXIF LightSource -> kelvin, as dng_camera_profile::IlluminantToTemperature.
+    static double illuminant_k(unsigned code) {
+        switch (code) {
+        case 3: case 17: return 2850;            // Tungsten, Standard A
+        case 24: return 3200;                    // ISO studio tungsten
+        case 23: return 5000;                    // D50
+        case 1: case 4: case 9: case 18: case 20: return 5500;  // Daylight, Flash, Fine, B, D55
+        case 10: case 19: case 21: return 6500;  // Cloudy, C, D65
+        case 11: case 22: return 7500;           // Shade, D75
+        case 12: return 6400;                    // Daylight fluorescent
+        case 13: return 5000;                    // Day white fluorescent
+        case 2: case 14: return 4150;            // Fluorescent, cool white
+        case 15: return 3450;                    // White fluorescent
+        case 16: return 2925;                    // Warm white fluorescent
