+        double g;  // weight of the low-temperature matrix
+        if (k <= lo) g = 1;
+        else if (k >= hi) g = 0;
+        else g = (1.0 / k - 1.0 / hi) / (1.0 / lo - 1.0 / hi);
+        double cm[9], cc[9];
+        for (int i = 0; i < 9; ++i) {
+            cm[i] = g * cm_[ilo][i] + (1 - g) * cm_[ihi][i];
+            cc[i] = g * cc_[ilo][i] + (1 - g) * cc_[ihi][i];
+        }
+        for (int r = 0; r < 3; ++r)
+            for (int c = 0; c < 3; ++c) {
+                double v = 0;
+                for (int j = 0; j < 3; ++j) v += cc[r * 3 + j] * cm[j * 3 + c];
+                out[r * 3 + c] = ab_[r] * v;
