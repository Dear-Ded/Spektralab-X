+    // McCamy's CCT from CIE xy; plenty for an inverse-CCT blend weight.
+    static double cct(double x, double y) {
+        const double d = 0.1858 - y;
+        if (std::fabs(d) < 1e-9) return 6500;
+        const double n = (x - 0.3320) / d;
+        const double t = ((449.0 * n + 3525.0) * n + 6823.3) * n + 5520.33;
+        return std::isfinite(t) ? std::fmin(std::fmax(t, 1500.0), 50000.0) : 6500;
+    }
